# Required — no default in packages/env, the server throws on startup without it.
# Origin allowed by CORS for the frontend (dev: Astro on 4321, prod: your domain).
CORS_ORIGIN=http://localhost:4321

# Everything below is optional; the values shown are the schema defaults.

# Path to the SQLite database file. In production, point this at a persistent volume.
DATABASE_URL=./local.db

# Where the markdown posts live, relative to the server's cwd.
POSTS_DIR=./content/posts

# The site URL fed to websitecarbon for byte measurement.
WEBSITECARBON_URL=https://burak.mulayim.app

# Whether the site is on a green-hosted provider. Cloudflare counts as green.
WEBSITECARBON_GREEN=true

# Last.fm — get an API key at https://www.last.fm/api/account/create
# user.getrecenttracks doesn't need the shared secret, only the api_key.
LASTFM_USER=buraksumer13
LASTFM_API_KEY=

# development | production | test. Set by Docker in prod; rarely set by hand.
NODE_ENV=development
