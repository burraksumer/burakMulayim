{
  "name": "e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:local": "bun run e2e:up && bun run test:e2e; status=$?; bun run e2e:down; exit $status",
    "test:e2e:ui": "bun run e2e:up && playwright test --ui; status=$?; bun run e2e:down; exit $status",
    "e2e:up": "docker compose --env-file ../../.env.local -f ../../docker-compose.yml -f ../../docker-compose.test.yml up -d --build --wait",
    "e2e:down": "docker compose --env-file ../../.env.local -f ../../docker-compose.yml -f ../../docker-compose.test.yml down -v",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@burakmulayim/config": "workspace:*",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "catalog:"
  }
}
