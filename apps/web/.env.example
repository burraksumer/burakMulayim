# URL the Astro app uses to reach the Elysia API. Astro inlines this at build
# time (see the `env.schema` block in astro.config.mjs), so it must be set when
# the image is built, not just at runtime.
#
# Local dev: http://localhost:3000
# In Docker: http://server:3000 — baked in as a build arg by apps/web/Dockerfile
PUBLIC_SERVER_URL=http://localhost:3000
