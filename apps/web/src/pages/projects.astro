---
import Layout from "../layouts/Layout.astro";
import BackNav from "../components/BackNav.astro";
import PageHeader from "../components/PageHeader.astro";
import PageMain from "../components/PageMain.astro";
import SectionLabel from "../components/SectionLabel.astro";

interface Project {
  name: string;
  href?: string;
  description: string;
  tag?: string;
}

const projects: Project[] = [
  {
    name: "burak.mulayim.app",
    href: "https://github.com/burraksumer/burakMulayim",
    description:
      "This site. Bun + Elysia API serving markdown posts; Astro frontend running on Bun. Designed to stay under 100KB per page.",
    tag: "open source",
  },
  // Add more as they happen. Keep the list short — quality over quantity.
];
---

<Layout title="Projects — Burak Sümer" description="Things I've built.">
  <PageMain>
    <BackNav href="/" label="home" />
    <PageHeader
      title="Projects"
      description="Things I've built that are still alive."
      class="mb-16"
    />

    <ul class="space-y-10">
      {
        projects.map((p) => {
          const isExternal = p.href?.startsWith("http") ?? false;
          const Wrapper = p.href ? "a" : "div";
          return (
            <li>
              <Wrapper
                href={p.href}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener noreferrer" : undefined}
                class="group/link block"
              >
                <h2 class="text-ink-1 group-hover/link:text-ink-accent font-serif text-xl">
                  {p.name}
                  {isExternal && (
                    <span
                      class="text-ink-3 group-hover/link:text-ink-accent ml-1 align-super font-mono text-[10px]"
                      aria-hidden="true"
                    >
                      ↗
                    </span>
                  )}
                </h2>
                {p.tag && (
                  <SectionLabel as="p" class="mt-1">
                    {p.tag}
                  </SectionLabel>
                )}
                <p class="text-ink-2 mt-3 text-[15px] leading-relaxed">{p.description}</p>
              </Wrapper>
            </li>
          );
        })
      }
    </ul>
  </PageMain>
</Layout>
