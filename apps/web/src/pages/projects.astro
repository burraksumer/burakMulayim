---
import Layout from "../layouts/Layout.astro";

interface Project {
  name: string;
  href?: string;
  description: string;
  tag?: string;
}

const projects: Project[] = [
  {
    name: "burak.mulayim.app",
    href: "https://github.com/burraksumer/burakMulayim",
    description:
      "This site. Bun + Elysia API serving markdown posts; Astro frontend running on Bun. Designed to stay under 100KB per page.",
    tag: "open source",
  },
  // Add more as they happen. Keep the list short — quality over quantity.
];
---

<Layout title="Projects — Burak Sümer" description="Things I've built.">
  <main class="mx-auto w-full max-w-2xl px-6 py-20 sm:py-28">
    <nav class="mb-12 font-mono text-xs">
      <a href="/" class="group/link text-ink-3 hover:text-ink-1">
        <span class="text-ink-3 group-hover/link:text-ink-accent mr-1" aria-hidden="true">←</span>
        home
      </a>
    </nav>

    <header class="mb-16">
      <h1 class="text-ink-1 font-serif text-3xl tracking-tight">Projects</h1>
      <p class="text-ink-2 mt-3">Things I've built that are still alive.</p>
    </header>

    <ul class="space-y-10">
      {
        projects.map((p) => {
          const isExternal = p.href?.startsWith("http") ?? false;
          const Wrapper = p.href ? "a" : "div";
          return (
            <li>
              <Wrapper
                href={p.href}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener noreferrer" : undefined}
                class="group/link block"
              >
                <h2 class="text-ink-1 group-hover/link:text-ink-accent font-serif text-xl">
                  {p.name}
                  {isExternal && (
                    <span
                      class="text-ink-3 group-hover/link:text-ink-accent ml-1 align-super font-mono text-[10px]"
                      aria-hidden="true"
                    >
                      ↗
                    </span>
                  )}
                </h2>
                {p.tag && (
                  <p class="text-ink-3 mt-1 font-mono text-xs tracking-[0.2em] uppercase">
                    {p.tag}
                  </p>
                )}
                <p class="text-ink-2 mt-3 text-[15px] leading-relaxed">{p.description}</p>
              </Wrapper>
            </li>
          );
        })
      }
    </ul>
  </main>
</Layout>
