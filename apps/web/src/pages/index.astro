---
import Layout from "../layouts/Layout.astro";

const SERVER_URL = import.meta.env.PUBLIC_SERVER_URL ?? "http://localhost:3000";

interface PostMeta {
  slug: string;
  title: string;
  date: string;
  excerpt: string;
  reading_time: number;
}

interface LastfmTrack {
  name: string;
  artist: string;
  url: string;
  played_at?: string;
  now_playing: boolean;
}

interface LastfmResponse {
  tracks: LastfmTrack[];
}

interface CarbonResponse {
  gco2e: number;
  bytes: number;
  rating: string;
  cleanerThan: number;
}

async function safeJson<T>(path: string): Promise<T | null> {
  try {
    const res = await fetch(`${SERVER_URL}${path}`, {
      signal: AbortSignal.timeout(2_000),
    });
    if (!res.ok) return null;
    return (await res.json()) as T;
  } catch {
    return null;
  }
}

const [posts, lastfm, carbon] = await Promise.all([
  safeJson<PostMeta[]>("/posts"),
  safeJson<LastfmResponse>("/lastfm"),
  safeJson<CarbonResponse>("/carbon"),
]);

const recentPosts = (posts ?? []).slice(0, 2);
const nowTrack = lastfm?.tracks.find((t) => t.now_playing) ?? lastfm?.tracks[0];

// Designed date like "2024.02.07" — reads well in mono and aligns predictably.
const fmtDate = (iso: string) => iso.slice(0, 10).replace(/-/g, ".");

const relativeTime = (iso?: string): string => {
  if (!iso) return "";
  const diff = Date.now() - new Date(iso).getTime();
  const min = Math.round(diff / 60_000);
  if (min < 1) return "just now";
  if (min < 60) return `${min}m ago`;
  const hr = Math.round(min / 60);
  if (hr < 24) return `${hr}h ago`;
  const day = Math.round(hr / 24);
  return `${day}d ago`;
};

const social = [
  { href: "https://github.com/burraksumer", label: "github" },
  { href: "https://x.com/burraksumer", label: "twitter" },
  { href: "https://www.last.fm/user/buraksumer13", label: "last.fm" },
  { href: "mailto:burak@stationwise.com", label: "email" },
];

// 512kb.club tier: "green" (<100KB), "orange" (100-250KB), "blue" (250-512KB).
// Flip if the deployed homepage stops qualifying.
const KB_CLUB_TIER: "green" | "orange" | "blue" = "green";
---

<Layout>
  <main class="mx-auto w-full max-w-2xl px-6 py-20 sm:py-28">
    <!-- Identity -->
    <section class="mb-16">
      <h1 class="font-serif text-3xl tracking-tight text-[var(--color-ink-1)]">
        Burak Sümer
      </h1>
      <p class="mt-3 max-w-prose text-[15px] leading-relaxed text-[var(--color-ink-2)]">
        Software engineer, building things in Istanbul. I write about minimal
        software, the web, and whatever else I'm thinking through.
      </p>
    </section>

    <!-- Latest writing -->
    <section class="mb-16">
      <h2
        class="mb-6 font-mono text-xs tracking-[0.2em] text-[var(--color-ink-3)] uppercase"
      >
        Writing
      </h2>
      {
        recentPosts.length === 0 ? (
          <p class="text-sm text-[var(--color-ink-3)]">No posts loaded.</p>
        ) : (
          <ul class="space-y-6">
            {recentPosts.map((p) => (
              <li>
                <a
                  href={`/posts/${p.slug}`}
                  class="group grid grid-cols-[5.5rem_1fr] gap-x-5 gap-y-1"
                >
                  <time
                    class="row-start-1 pt-[3px] font-mono text-xs text-[var(--color-ink-3)] tabular-nums"
                    datetime={p.date}
                  >
                    {fmtDate(p.date)}
                  </time>
                  <h3 class="row-start-1 font-serif text-lg text-[var(--color-ink-1)] group-hover:text-[var(--color-ink-accent)]">
                    {p.title}
                  </h3>
                  {p.excerpt && (
                    <p class="col-start-2 row-start-2 line-clamp-2 text-sm text-[var(--color-ink-2)]">
                      {p.excerpt}
                    </p>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <a
        href="/posts"
        class="group/link mt-6 inline-block font-mono text-xs text-[var(--color-ink-3)] hover:text-[var(--color-ink-1)]"
      >
        all posts
        <span
          class="ml-1 text-[var(--color-ink-3)] group-hover/link:text-[var(--color-ink-accent)]"
          aria-hidden="true">→</span
        >
      </a>
    </section>

    <!-- Now -->
    {
      nowTrack && (
        <section class="mb-16">
          <h2 class="mb-6 font-mono text-xs tracking-[0.2em] text-[var(--color-ink-3)] uppercase">
            Currently
          </h2>
          <div class="grid grid-cols-[5.5rem_1fr] gap-x-5">
            <span
              class="row-start-1 inline-flex items-center gap-2 pt-[3px] font-mono text-xs whitespace-nowrap tabular-nums"
            >
              {
                nowTrack.now_playing ? (
                  <>
                    <span class="relative inline-flex h-1.5 w-1.5">
                      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75" />
                      <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400" />
                    </span>
                    <span class="text-[var(--color-ink-1)]">now</span>
                  </>
                ) : (
                  <span class="text-[var(--color-ink-3)]">{relativeTime(nowTrack.played_at)}</span>
                )
              }
            </span>
            <a
              href={nowTrack.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group/link row-start-1 text-[15px] text-[var(--color-ink-2)] hover:text-[var(--color-ink-1)]"
            >
              <span class="font-serif italic">{nowTrack.name}</span>
              <span> — {nowTrack.artist}</span>
              <span
                class="ml-1 align-super font-mono text-[10px] text-[var(--color-ink-3)] group-hover/link:text-[var(--color-ink-accent)]"
                aria-hidden="true">↗</span
              >
            </a>
          </div>
        </section>
      )
    }

    <!-- Elsewhere -->
    <section class="mb-16">
      <h2
        class="mb-6 font-mono text-xs tracking-[0.2em] text-[var(--color-ink-3)] uppercase"
      >
        Elsewhere
      </h2>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {
          social.map((s) => {
            const isHttp = s.href.startsWith("http");
            return (
              <li>
                <a
                  href={s.href}
                  target={isHttp ? "_blank" : undefined}
                  rel={isHttp ? "noopener noreferrer" : undefined}
                  class="group/link text-[var(--color-ink-2)] hover:text-[var(--color-ink-1)]"
                >
                  {s.label}
                  <span
                    class="ml-0.5 align-super font-mono text-[10px] text-[var(--color-ink-3)] group-hover/link:text-[var(--color-ink-accent)]"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <!-- Footer / lean-web markers -->
    <footer
      class="mt-24 border-t border-[var(--color-ink-rule)] pt-6 font-mono text-xs text-[var(--color-ink-3)]"
    >
      <p>
        {
          carbon ? (
            <>
              this page emits ≈ {carbon.gco2e.toFixed(4)}g CO₂ — cleaner than{" "}
              {Math.round(carbon.cleanerThan * 100)}%
              <span class="ml-1 text-[var(--color-ink-2)]">({carbon.rating})</span>
            </>
          ) : (
            <>built lean</>
          )
        }
        <span class="mx-2 text-[var(--color-ink-rule)]">·</span>
        <a
          href="https://512kb.club/"
          target="_blank"
          rel="noopener noreferrer"
          class="group/link hover:text-[var(--color-ink-1)]"
        >
          512kb.club {KB_CLUB_TIER}
          <span
            class="ml-0.5 align-super font-mono text-[10px] text-[var(--color-ink-3)] group-hover/link:text-[var(--color-ink-accent)]"
            aria-hidden="true"
          >
            ↗
          </span>
        </a>
      </p>
    </footer>
  </main>
</Layout>
