---
import Layout from "../layouts/Layout.astro";
import BackNav from "../components/BackNav.astro";
import ExternalLink from "../components/ExternalLink.astro";
import MarkdownBody from "../components/MarkdownBody.astro";
import PageHeader from "../components/PageHeader.astro";
import PageMain from "../components/PageMain.astro";
import { api, fmtLongDate } from "../lib/api";
import { marked } from "marked";

const now = await api.now();
const bodyHtml = now ? await marked.parse(now.body) : null;
---

<Layout title="Now — Burak Sümer" description="What I'm currently focused on.">
  <PageMain>
    <BackNav href="/" label="home" />
    <PageHeader title="Now">
      {
        now && (
          <div class="text-ink-3 mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs">
            <span>
              Updated{" "}
              <time datetime={now.last_modified} class="tabular-nums">
                {fmtLongDate(now.last_modified)}
              </time>
            </span>
            <span aria-hidden="true">·</span>
            <ExternalLink href="https://nownownow.com/about" class="hover:text-ink-1">
              nownownow.com
            </ExternalLink>
          </div>
        )
      }
    </PageHeader>

    {now ? <MarkdownBody html={bodyHtml ?? ""} /> : <p class="text-ink-3">Now page unavailable.</p>}
  </PageMain>
</Layout>
