---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About — Burak Sümer" description="About Burak.">
  <main class="mx-auto w-full max-w-2xl px-6 py-20 sm:py-28">
    <nav class="mb-12 font-mono text-xs">
      <a href="/" class="group/link text-ink-3 hover:text-ink-1">
        <span class="text-ink-3 group-hover/link:text-ink-accent mr-1" aria-hidden="true">←</span>
        home
      </a>
    </nav>

    <header class="mb-12">
      <h1 class="text-ink-1 font-serif text-3xl tracking-tight">About</h1>
    </header>

    <div class="text-ink-1 space-y-5 text-[15px] leading-relaxed">
      <p>
        Hi, I'm Burak. I'm a software engineer based in Istanbul. I work on web infrastructure, lean
        software, and the small in-between things that make tools feel good to use.
      </p>
      <p>
        This site is intentionally minimal — under 100 KB per page, self-hosted, no analytics, no
        cookies. Source is on
        <a
          href="https://github.com/burraksumer/burakMulayim"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink-1 decoration-ink-3 hover:decoration-ink-accent underline underline-offset-[3px]"
        >
          GitHub
        </a>.
      </p>
      <p class="text-ink-2">
        Best way to reach me is email or twitter, both linked from the homepage.
      </p>
    </div>
  </main>
</Layout>
