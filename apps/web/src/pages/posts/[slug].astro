---
import Layout from "../../layouts/Layout.astro";
import BackNav from "../../components/BackNav.astro";
import MarkdownBody from "../../components/MarkdownBody.astro";
import PageHeader from "../../components/PageHeader.astro";
import PageMain from "../../components/PageMain.astro";
import TagList from "../../components/TagList.astro";
import { api, fmtLongDate } from "../../lib/api";
import { marked } from "marked";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/posts");

const post = await api.post(slug);
if (!post) {
  return Astro.rewrite("/404");
}

// Configure marked: GitHub-flavored markdown, no smart-everything quirks.
marked.setOptions({ gfm: true, breaks: false });
const bodyHtml = await marked.parse(post.body);
---

<Layout title={`${post.title} — Burak Sümer`} description={post.description ?? post.excerpt}>
  <PageMain>
    <BackNav href="/posts" label="writing" />

    <article>
      <PageHeader title={post.title} size="large">
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
          <time class="text-ink-3 font-mono text-xs tabular-nums" datetime={post.date}>
            {fmtLongDate(post.date)}
          </time>
          <span class="text-ink-3 font-mono text-xs tabular-nums">{post.reading_time} min</span>
          <TagList tags={post.tags} />
        </div>
      </PageHeader>

      <MarkdownBody html={bodyHtml} />
    </article>
  </PageMain>
</Layout>
