---
import Layout from "../../layouts/Layout.astro";
import { api, fmtDate, type PostMeta } from "../../lib/api";

const posts = (await api.posts()) ?? [];

// Group posts by year, descending. Posts are already date-desc sorted by the API.
const byYear = new Map<string, PostMeta[]>();
for (const p of posts) {
  const year = p.date.slice(0, 4);
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(p);
}
const years = Array.from(byYear.keys());
---

<Layout title="Writing — Burak Sümer" description="All posts.">
  <main class="mx-auto w-full max-w-2xl px-6 py-20 sm:py-28">
    <!-- Breadcrumb / back -->
    <nav class="mb-12 font-mono text-xs">
      <a
        href="/"
        class="group/link text-[var(--color-ink-3)] hover:text-[var(--color-ink-1)]"
      >
        <span
          class="mr-1 text-[var(--color-ink-3)] group-hover/link:text-[var(--color-ink-accent)]"
          aria-hidden="true">←</span
        >
        home
      </a>
    </nav>

    <header class="mb-16">
      <h1 class="font-serif text-3xl tracking-tight text-[var(--color-ink-1)]">Writing</h1>
      <p class="mt-3 text-[var(--color-ink-2)]">
        {posts.length} {posts.length === 1 ? "post" : "posts"}, oldest 2022. Long
        reads, short letters, technical notes.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="text-[var(--color-ink-3)]">Posts unavailable.</p>
      ) : (
        years.map((year) => (
          <section class="mb-12">
            <h2 class="mb-6 font-mono text-xs tracking-[0.2em] text-[var(--color-ink-3)] uppercase">
              {year}
            </h2>
            <ul class="space-y-6">
              {byYear.get(year)!.map((p) => (
                <li>
                  <a
                    href={`/posts/${p.slug}`}
                    class="group grid grid-cols-[5.5rem_1fr] gap-x-5 gap-y-1"
                  >
                    <time
                      class="row-start-1 pt-[3px] font-mono text-xs text-[var(--color-ink-3)] tabular-nums"
                      datetime={p.date}
                    >
                      {fmtDate(p.date)}
                    </time>
                    <h3 class="row-start-1 font-serif text-lg text-[var(--color-ink-1)] group-hover:text-[var(--color-ink-accent)]">
                      {p.title}
                    </h3>
                    {p.excerpt && (
                      <p class="col-start-2 row-start-2 line-clamp-2 text-sm text-[var(--color-ink-2)]">
                        {p.excerpt}
                      </p>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </main>
</Layout>
