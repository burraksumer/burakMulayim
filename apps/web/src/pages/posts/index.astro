---
import Layout from "../../layouts/Layout.astro";
import { api, fmtDate, type PostMeta } from "../../lib/api";

const posts = (await api.posts()) ?? [];

// Group posts by year, descending. Posts are already date-desc sorted by the API.
const byYear = new Map<string, PostMeta[]>();
for (const p of posts) {
  const year = p.date.slice(0, 4);
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(p);
}
const years = Array.from(byYear.keys());
---

<Layout title="Writing — Burak Sümer" description="All posts.">
  <main class="mx-auto w-full max-w-2xl px-6 py-20 sm:py-28">
    <!-- Breadcrumb / back -->
    <nav class="mb-12 font-mono text-xs">
      <a href="/" class="group/link text-ink-3 hover:text-ink-1">
        <span class="text-ink-3 group-hover/link:text-ink-accent mr-1" aria-hidden="true">←</span>
        home
      </a>
    </nav>

    <header class="mb-16">
      <h1 class="text-ink-1 font-serif text-3xl tracking-tight">Writing</h1>
      <p class="text-ink-2 mt-3">
        {posts.length}
        {posts.length === 1 ? "post" : "posts"}, oldest 2022. Long reads, short letters, technical
        notes.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="text-ink-3">Posts unavailable.</p>
      ) : (
        years.map((year) => (
          <section class="mb-12">
            <h2 class="text-ink-3 mb-6 font-mono text-xs tracking-[0.2em] uppercase">{year}</h2>
            <ul class="space-y-6">
              {byYear.get(year)!.map((p) => (
                <li>
                  <a
                    href={`/posts/${p.slug}`}
                    class="group grid grid-cols-[5.5rem_1fr] gap-x-5 gap-y-1"
                  >
                    <time
                      class="text-ink-3 row-start-1 pt-0.75 font-mono text-xs tabular-nums"
                      datetime={p.date}
                    >
                      {fmtDate(p.date)}
                    </time>
                    <h3 class="text-ink-1 group-hover:text-ink-accent row-start-1 font-serif text-lg">
                      {p.title}
                    </h3>
                    {p.excerpt && (
                      <p class="text-ink-2 col-start-2 row-start-2 line-clamp-2 text-sm">
                        {p.excerpt}
                      </p>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </main>
</Layout>
