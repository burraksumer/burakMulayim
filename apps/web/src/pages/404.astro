---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import PageMain from "../components/PageMain.astro";
import SectionLabel from "../components/SectionLabel.astro";

interface NavItem {
  href: string;
  label: string;
}

const places: NavItem[] = [
  { href: "/", label: "home" },
  { href: "/posts", label: "writing" },
  { href: "/tags", label: "tags" },
  { href: "/now", label: "now" },
  { href: "/about", label: "about" },
  { href: "/projects", label: "projects" },
];

const description =
  "That page either doesn't exist, or moved somewhere else. If you followed a link from outside, sorry — try one of these instead:";
---

<Layout title="Not found — Burak Sümer" description="That page doesn't exist.">
  <PageMain>
    <PageHeader title="Not found" description={description}>
      <SectionLabel as="p" slot="eyebrow" class="mb-2">404</SectionLabel>
    </PageHeader>

    <ul class="grid grid-cols-[3rem_1fr] items-baseline gap-x-5 gap-y-4">
      {
        places.map((p, i) => (
          <li class="contents">
            <span class="text-ink-3 font-mono text-xs tabular-nums" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <a href={p.href} class="text-ink-1 hover:text-ink-accent font-serif text-lg">
              {p.label}
            </a>
          </li>
        ))
      }
    </ul>
  </PageMain>
</Layout>
