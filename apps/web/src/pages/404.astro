---
import Layout from "../layouts/Layout.astro";

interface NavItem {
  href: string;
  label: string;
}

const places: NavItem[] = [
  { href: "/", label: "home" },
  { href: "/posts", label: "writing" },
  { href: "/tags", label: "tags" },
  { href: "/now", label: "now" },
  { href: "/about", label: "about" },
  { href: "/projects", label: "projects" },
];
---

<Layout title="Not found — Burak Sümer" description="That page doesn't exist.">
  <main class="mx-auto w-full max-w-2xl px-6 py-20 sm:py-28">
    <header class="mb-12">
      <p class="text-ink-3 mb-2 font-mono text-xs tracking-[0.2em] uppercase">404</p>
      <h1 class="text-ink-1 font-serif text-3xl tracking-tight">Not found</h1>
      <p class="text-ink-2 mt-3">
        That page either doesn't exist, or moved somewhere else. If you followed a link from
        outside, sorry — try one of these instead:
      </p>
    </header>

    <ul class="grid grid-cols-[3rem_1fr] items-baseline gap-x-5 gap-y-4">
      {
        places.map((p, i) => (
          <li class="contents">
            <span class="text-ink-3 font-mono text-xs tabular-nums" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <a href={p.href} class="text-ink-1 hover:text-ink-accent font-serif text-lg">
              {p.label}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
