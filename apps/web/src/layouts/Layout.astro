---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SiteFooter from "../components/SiteFooter.astro";

interface ArticleMeta {
  /** ISO date string. Renders as og:article:published_time. */
  publishedTime: string;
  /** Display name for og:article:author. */
  author?: string;
  /** Each tag renders as a separate og:article:tag meta. */
  tags?: string[];
}

interface Props {
  title?: string;
  description?: string;
  /**
   * When set, the page is treated as an article: og:type flips to "article"
   * and the article-specific og:article:* meta tags are emitted. Leave undefined
   * for landing/index/non-post pages.
   */
  article?: ArticleMeta;
  /**
   * Absolute or root-relative URL for the social-preview image. Defaults to
   * the site-wide og-default.png. Override per-page if you ever generate
   * per-post images.
   */
  ogImage?: string;
}

const {
  title = "Burak Sümer",
  description = "Personal blog and notes.",
  article,
  ogImage = "/og/default.png",
} = Astro.props;

// Canonical URL for this page. `Astro.site` is configured in astro.config.mjs
// to the apex public domain; here we layer the current path onto it. This
// gives every page a stable canonical regardless of how it was reached
// (with/without query string, via redirect, etc.).
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Absolute URL for og:image — most social platforms require absolute,
// not root-relative, even though the spec allows both.
const ogImageUrl = new URL(ogImage, Astro.site).href;

// Feeds are served on the apex (proxied through to the API by
// apps/web/src/pages/feed.xml.ts and feed.json.ts). Same-origin links are
// friendlier to feed readers and easier for browsers to autodiscover.
const feedXml = new URL("/feed.xml", Astro.site).href;
const feedJson = new URL("/feed.json", Astro.site).href;

const ogType = article ? "article" : "website";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Burak Sümer" href={feedXml} />
    <link rel="alternate" type="application/feed+json" title="Burak Sümer" href={feedJson} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Burak Sümer" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {
      /* Twitter Card — uses og:* fallbacks for most fields; explicit twitter:* tags
        give finer control on platforms that read them. */
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Article-only meta (post pages) */}
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime} />
          {article.author && <meta property="article:author" content={article.author} />}
          {article.tags?.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    {
      /* Skip link — first focusable element on every page. Hidden offscreen
        by default; slides into view only when keyboard-focused (typically a
        single Tab from the address bar). Lets keyboard users jump past any
        nav/breadcrumb directly to the page's <main>. */
    }
    <a
      href="#main"
      class="bg-ink-bg text-ink-1 border-ink-rule focus:ring-ink-accent absolute top-2 left-2 z-50 -translate-y-16 rounded border px-3 py-2 font-mono text-xs transition-transform focus:translate-y-0 focus:ring-2 focus:outline-none"
    >
      Skip to content
    </a>
    <div class="flex-1">
      <slot />
    </div>
    <SiteFooter />
  </body>
</html>
