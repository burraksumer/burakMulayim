---
import type { PostMeta } from "@burakmulayim/shared";
import { fmtDate } from "@burakmulayim/shared";

/**
 * One row in a list of posts: date column + serif title + clamped excerpt.
 * The whole row is the link surface; title shifts to amber on hover.
 *
 * Used on the homepage Writing section, /posts (grouped by year), and
 * /tags/<slug> filtered lists.
 */
interface Props {
  post: PostMeta;
}

const { post } = Astro.props;
---

<a href={`/posts/${post.slug}`} class="group grid grid-cols-[5.5rem_1fr] gap-x-5 gap-y-1">
  <time class="text-ink-3 row-start-1 pt-0.75 font-mono text-xs tabular-nums" datetime={post.date}>
    {fmtDate(post.date)}
  </time>
  <h3 class="text-ink-1 group-hover:text-ink-accent row-start-1 font-serif text-lg">
    {post.title}
  </h3>
  {
    post.excerpt && (
      <p class="text-ink-2 col-start-2 row-start-2 line-clamp-2 text-sm">{post.excerpt}</p>
    )
  }
</a>
