---
/**
 * Standard page header: optional eyebrow label (e.g. "Tag", "404"), the
 * <h1> title, an optional one-line description, and an optional meta slot
 * for richer rows below (date + reading time + tags on post pages,
 * "Updated …" on /now, etc.).
 *
 * Slots:
 *   - `eyebrow`  → SectionLabel above the title
 *   - default    → meta row(s) below the description
 *
 * Use `size="large"` for the post-page hero title (text-4xl + balanced).
 */
interface Props {
  title: string;
  description?: string | undefined;
  size?: "default" | "large";
  class?: string;
}

const { title, description, size = "default", class: className } = Astro.props;

const titleClass =
  size === "large"
    ? "text-ink-1 font-serif text-4xl leading-tight tracking-tight text-balance"
    : "text-ink-1 font-serif text-3xl tracking-tight";
---

<header class:list={["mb-12", className]}>
  <slot name="eyebrow" />
  <h1 class={titleClass}>{title}</h1>
  {description && <p class="text-ink-2 mt-3">{description}</p>}
  <slot />
</header>
