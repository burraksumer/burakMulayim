---
/**
 * An in-app anchor with a trailing "→" arrow that goes amber on hover.
 * The arrow is locked to mono text-xs regardless of parent text size, so
 * all internal CTAs ("all posts →", "what i'm up to →") share one visual.
 *
 * Caller controls the link text styling via slot + `class` prop.
 */
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a href={href} class:list={["group/link", className]}>
  <slot />
  <span
    class="text-ink-3 group-hover/link:text-ink-accent ml-1 font-mono text-xs"
    aria-hidden="true"
  >
    →
  </span>
</a>
