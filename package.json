{
  "name": "burak-mulayim",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "@typescript/native-preview": "7.0.0-dev.20260506.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bun run --filter server dev",
    "db:push": "bun run --filter @burakmulayim/db db:push",
    "db:studio": "bun run --filter @burakmulayim/db db:studio",
    "db:generate": "bun run --filter @burakmulayim/db db:generate",
    "db:migrate": "bun run --filter @burakmulayim/db db:migrate",
    "check": "oxlint && oxfmt --write --ignore-path .gitignore && prettier --write .",
    "check:ci": "oxlint && oxfmt --check --ignore-path .gitignore && prettier --check .",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --filter e2e test:e2e",
    "test:e2e:ui": "bun run --filter e2e test:e2e:ui",
    "test:e2e:docker": "bun run --filter e2e test:e2e:docker",
    "prepare": "husky"
  },
  "dependencies": {
    "@burakmulayim/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@burakmulayim/config": "workspace:*",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "oxlint-tailwindcss": "^0.7.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint",
      "oxfmt --write --ignore-path .gitignore"
    ],
    "*.{astro,json,jsonc,md,mdx,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "bun@1.3.13"
}
