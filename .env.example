# Copy to .env.local. Read by docker compose via `--env-file .env.local`,
# which is how `bun run test:e2e:docker` boots web + server. Without this file
# compose fails before it builds anything.

# Last.fm API key — https://www.last.fm/api/account/create
# Also required as a GitHub Actions repository secret named LASTFM_API_KEY:
# the e2e job recreates this file from it, and the /lastfm spec asserts a
# hard 200 with no cached fallback in a cold container.
LASTFM_API_KEY=
